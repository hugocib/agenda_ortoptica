# Copie para .env e ajuste. O .env não vai para o git.

# Pasta no servidor onde ficam a base de dados (db/) e as cópias de segurança (backups/).
# Tem de pertencer ao uid 1000:  sudo mkdir -p $DATA_DIR/db $DATA_DIR/backups && sudo chown -R 1000:1000 $DATA_DIR
DATA_DIR=/srv/data/appdata/ortoptica

# Porta publicada no servidor e interface onde fica à escuta.
# 0.0.0.0 = todas; 127.0.0.1 = só a própria máquina (quando servida por «tailscale serve»).
APP_PORT=3000
APP_BIND=0.0.0.0

# true quando há um proxy HTTPS à frente (tailscale serve, Nginx Proxy Manager):
# a app passa a confiar nos cabeçalhos X-Forwarded-* para saber que o acesso é HTTPS.
# false quando se acede diretamente por http://IP:porta.
TRUST_PROXY=true

# Sessão termina após estas horas sem uso; cópias guardadas e intervalo entre cópias.
SESSION_IDLE_HOURS=10
BACKUP_KEEP=30
BACKUP_EVERY_HOURS=24
